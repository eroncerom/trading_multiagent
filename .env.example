# --- CONFIGURACIÓN GENERAL ---
TIMEZONE=Europe/Madrid

# --- GEMINI API KEY ---
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- N8N CONFIG ---
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esta_password_segura

# --- NGROK (Para recibir el clic de Aprobar/Rechazar desde Telegram en local) ---
NGROK_AUTHTOKEN=tu_token_gratuito_de_ngrok
NGROK_STATIC_DOMAIN=tu-dominio-gratuito.ngrok-free.app

# --- SUPABASE (Auditoría y Estado de Cartera) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_o_service_role_key

# --- BRÓKER (Alpaca Paper Trading) ---
ALPACA_API_KEY=tu_alpaca_api_key_aqui
ALPACA_SECRET_KEY=tu_alpaca_secret_key_aqui
ALPACA_PAPER=true

# --- PARÁMETROS DE RIESGO ESTRICTOS ---
# 1% máximo de la cartera en riesgo por operación
MAX_PORTFOLIO_RISK_PCT=0.01
# Comisión por orden en €/$
BROKER_COMMISSION_PER_ORDER=0.35
# La comisión total nunca puede superar el 10% del beneficio bruto
MAX_COMMISSION_TO_PROFIT_RATIO=0.10

# --- MOTOR AUTÓNOMO DE ESCANEO ---
SCANNER_INTERVAL_SECONDS=10
SCANNER_AUTO_START=false
SCANNER_DEFAULT_TICKERS=
DEFAULT_PORTFOLIO_VALUE=5000.0
DEFAULT_SLIPPAGE_BUFFER_PCT=0.0015
N8N_OPPORTUNITY_WEBHOOK_URL=
MAX_POSITION_ALLOCATION_PCT=0.35
